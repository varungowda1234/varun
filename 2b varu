#include <stdio.h>
#include <stdlib.h>

struct time
{
    int h, m, s;
    struct time *next;
};

int main()
{
    struct time *t1, *t2;

    t1 = malloc(sizeof(struct time));
    t2 = malloc(sizeof(struct time));

    printf("Enter the hour, minute and second for time1:\n");
    scanf("%d%d%d", &t1->h, &t1->m, &t1->s);

    printf("Enter the hour, minute and second for time2:\n");
    scanf("%d%d%d", &t2->h, &t2->m, &t2->s);

    t1->next = t2;
    t2->next = NULL;

    printf("Time 1: %d:%d:%d\n", t1->h, t1->m, t1->s);
    printf("Time 2: %d:%d:%d\n", t1->next->h,
           t1->next->m, t1->next->s);

    free(t1);
    free(t2);

    return 0;
}
